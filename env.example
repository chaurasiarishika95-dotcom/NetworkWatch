# Optional: persistent scenario history. Use a dedicated Supabase project for this prototype.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY

# Optional: Gemini-powered operations copilot. Without this, a deterministic fallback explanation is returned.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: TomTom Routing API key for traffic-aware journey-time estimates.
# Without this key, the app uses OSRM/OpenStreetMap baseline routing without live traffic.
TOMTOM_API_KEY=
